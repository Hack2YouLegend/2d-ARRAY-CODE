#include <stdio.h>
int main()
{
	int arr[299][299],a,b;
	printf("ENTER YOUR ROW  : ");
	scanf("%d",&a);
	printf("\n");
	printf("ENTER YOUR COLOUMN : ");
	scanf("%d",&b);
	printf("\n");
	for(int i = 0; i<a; i++)
	{
		for(int j = 0; j<b; j++)
		{
			printf("ENTER YOUR ELEMENT [%d][%d] : ",i,j);
			scanf("%d",&arr[i][j]);
		}
		printf("\n");
	}
	printf("YOUR MATRIX\n");
	for(int i =0; i<a; i++)
	{
		for(int j =0; j<b; j++)
		{
			printf("%d\t",arr[i][j]);
		}
		printf("\n");
	}
	printf("CHANGE INTO ROW TO COLOUM\n");
	for(int i = 0; i<b; i++)
	{
		for(int j = 0; j<a; j++)
		{
			printf("%d\t",arr[j][i]);
		}
		printf("\n");
	}
}
